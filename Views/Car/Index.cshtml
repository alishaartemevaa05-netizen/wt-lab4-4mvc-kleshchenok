@model List<Car>
@{
    ViewData["Title"] = "Автомобили";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">🚗 Каталог автомобилей</h1>
            <p class="text-muted">Прокат автомобилей</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">➕ Добавить автомобиль</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Список пуст.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body">
                            <span class="badge bg-secondary mb-2">ID: @car.Id</span>
                            @if (car.IsAvailable)
                            {
                                <span class="badge bg-success mb-2">Доступен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger mb-2">В аренде</span>
                            }
                            <h5 class="card-title">@car.Brand @car.Model</h5>
                            <p class="text-muted mb-1">Год: @car.Year</p>
                            <p class="fs-4 fw-bold">@car.PricePerDay руб./сутки</p>
                            <a asp-action="Details" asp-route-id="@car.Id"
                               class="btn btn-outline-primary">Подробнее</a>
                     <form asp-action="Delete" asp-route-id="@car.Id" method="post" class="d-inline">
    <button type="submit" class="btn btn-outline-danger"
            onclick="return confirm('Удалить @car.Brand @car.Model?')">
        🗑️ Удалить
    </button>
</form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>